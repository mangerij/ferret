[Tests]
  [./dielectric_sphere]
    type = 'Exodiff'
    input = 'dielectric_sphere_test_steady.i'
    exodiff = 'out_lindie_sph_test.e'
    use_old_floor = true
    abs_zero = 1e-5
  [../]
  [./polar_sphere]
    type = 'Exodiff'
    input = 'poisson_sphere_test_steady.i'
    exodiff = 'out_polar_sph_test.e'
    use_old_floor = true
    abs_zero = 1e-5
  [../]
  [./die_layer]
    type = 'Exodiff'
    input = 'FE_8nmFilm_Die_4nmLayer_U0.i'
    exodiff = 'out_FE_8nmFilm_Die_4nmLayer_U0.e'
  [../]
  [./pto_sto_2D_E]
    type = 'Exodiff'
    input = 'PTO_STO_2D_E_full.i'
    exodiff = 'PTO_STO_2D_E_full_exo.e'
    # phi is pinned at one node, so at any step where the potential happens to be
    # <= 0 everywhere, phi_max IS that pinned node: ~1e-9, a numerical zero that
    # exodiff would otherwise compare in RELATIVE terms and always fail on.
    # 1e-8 sits above the cross-partition noise floor (~3e-9) and a factor 2.5e5
    # below the smallest physically meaningful quantity in the file (Felec ~ 2.5e-3).
    abs_zero = 1e-8
